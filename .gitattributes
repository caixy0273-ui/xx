# Normalize line endings for a cross-platform repo.
# The toolkit is pure text (Markdown, JSON, Python) and CI runs on Linux.
* text=auto eol=lf

*.py   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Windows-only helpers, if any are ever added
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary
*.png  binary
*.jpg  binary
*.pdf  binary
